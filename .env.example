# Copy to .env (git-ignored) and fill in. Never commit real keys.
SENSO_API_KEY=tgr_...
OPENAI_API_KEY=sk-...
LLM_API_KEY=${OPENAI_API_KEY}       # Cognee reads this
PERSONA_API_KEY=persona_sandbox_...
PERSONA_TEMPLATE_ID=itmpl_...
PERSONA_ENVIRONMENT_ID=env_...
STATSIG_SERVER_SECRET_KEY=secret-...
SINGLESTORE_URL=mysql://user:pass@host:3306/sleigh   # optional; falls back to SQLite
POLICY_MODE=enforce                 # "log" for the before-fix Firedrill run
